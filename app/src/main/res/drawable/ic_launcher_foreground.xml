<?xml version="1.0" encoding="utf-8"?>
<!--
  The sprout from assets/canopy-logo.svg, path for path, in the favicon's own
  128x128 coordinate system.

  The group both re-centres and shrinks it. The artwork's bounding box is centred
  on (67.75, 66.75) rather than on the canvas, so the pivot sits there and the
  translate carries that point to (64, 64).

  0.68 is the size. Only the middle 66% of an adaptive icon survives the
  launcher's mask, and a glyph is meant to sit *inside* that circle rather than
  fill it — at the previous 0.88 the sprout ran almost edge to edge and read as
  cramped next to every other icon on the home screen. This leaves it about 60%
  of the visible circle, which is the usual keyline for a shape on a coloured
  background.

  White rather than the near-black of the web favicon: on the green tile it is
  the higher-contrast pair, and it matches how the other icons on a home screen
  carry their glyph.

  Doubles as the monochrome icon — themed launchers re-tint the strokes flat, so
  the colour here does not reach that variant.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="128"
    android:viewportHeight="128">
    <group
        android:pivotX="67.75"
        android:pivotY="66.75"
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:translateX="-3.75"
        android:translateY="-2.75">
        <path
            android:pathData="M45,101h38"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M62,101c20,-9 3,-23 11,-36"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M60,52c4,3 7,8 8.5,13.5 -7.5,1.5 -13,1.5 -17.5,-1s-8.5,-7 -11,-15c10,-2 16,0 20,2.5z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M77,40a26,26 0 0 0 -4,15c7,-0.5 12,-2.5 16,-5.5 3.5,-3.5 6,-8.5 6.5,-17 -10,0.5 -15,3.5 -18.5,7.5z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
