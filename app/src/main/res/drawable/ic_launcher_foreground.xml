<?xml version="1.0" encoding="utf-8"?>
<!--
  The sprout from assets/canopy-logo.svg, path for path, in the favicon's own
  128x128 coordinate system.

  The group re-centres it: the artwork's bounding box sits at (67.75, 66.75)
  rather than the canvas centre, and 0.88 pulls the ground line's left end
  inside the adaptive icon's safe circle, which a full-size copy would clip.

  Doubles as the monochrome icon — themed launchers tint the strokes flat and
  the shape still reads.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="128"
    android:viewportHeight="128">
    <group
        android:pivotX="67.75"
        android:pivotY="66.75"
        android:scaleX="0.88"
        android:scaleY="0.88"
        android:translateX="-3.75"
        android:translateY="-2.75">
        <path
            android:pathData="M45,101h38"
            android:strokeColor="#FF06210F"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M62,101c20,-9 3,-23 11,-36"
            android:strokeColor="#FF06210F"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M60,52c4,3 7,8 8.5,13.5 -7.5,1.5 -13,1.5 -17.5,-1s-8.5,-7 -11,-15c10,-2 16,0 20,2.5z"
            android:strokeColor="#FF06210F"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M77,40a26,26 0 0 0 -4,15c7,-0.5 12,-2.5 16,-5.5 3.5,-3.5 6,-8.5 6.5,-17 -10,0.5 -15,3.5 -18.5,7.5z"
            android:strokeColor="#FF06210F"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
